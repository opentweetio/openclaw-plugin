{
  "name": "@opentweetio/openclaw-plugin",
  "version": "0.2.1",
  "description": "Schedule and publish posts to X, Bluesky and LinkedIn from OpenClaw using OpenTweet: posts, threads, X Articles, media and analytics.",
  "type": "module",
  "license": "MIT",
  "author": "OpenTweet <hello@opentweet.io>",
  "homepage": "https://opentweet.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentweetio/openclaw-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/opentweetio/openclaw-plugin/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "opentweet",
    "twitter",
    "x",
    "scheduling",
    "social-media",
    "bluesky",
    "linkedin",
    "cross-posting",
    "mcp"
  ],
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "manifest": "openclaw plugins build --entry ./dist/index.js",
    "manifest:check": "openclaw plugins build --entry ./dist/index.js --check",
    "validate": "openclaw plugins validate --entry ./dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.8.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  }
}
